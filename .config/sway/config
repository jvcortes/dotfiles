include $HOME/.config/sway/user/colors

set $mod Mod4

# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l

set $emacs emacs --daemon
set $filecloud maestral start
set $term_server foot --server
set $term footclient
set $dropdown footclient -a dropdown
set $dropdown_id dropdown
set $dropdown_dimensions move position center, resize set width 60 ppt height 50 ppt

set $menu ~/.config/sway/scripts/rofi.sh
set $powermenu rofi -show power-menu -modi power-menu:~/.local/bin/rofi-power-menu -config ~/.config/rofi/power-menu.rasi
set $idle ~/.config/sway/scripts/idle.sh
set $idle_inhibitor sway-audio-idle-inhibit
set $lock ~/.config/sway/scripts/lock.sh
set $wallpaper hyprpaper
set $bar waybar
set $notifications mako
set $swayr exec env RUST_BACKTRACE=1 RUST_LOG=swayr=debug swayrd > /tmp/swayrd.log 2>&1
# set $udiskie udiskie --smart-tray

set $keepassxc_id org.keepassxc.KeePassXC
set $keepassxc_dimensions move position center, resize set width 60 ppt height 50 ppt

set $display_config way-displays

set $brscan-skey /opt/brother/scanner/brscan-skey/brscan-skey

input type:keyboard {
	xkb_layout us(altgr-intl)
}

exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway

# Window borders
default_border pixel 2
default_floating_border normal
hide_edge_borders smart

for_window {
	[app_id=$dropdown_id] {
		move to scratchpad
			[app_id=$dropdown_id] scratchpad show
			$dropdown_dimensions
	}
	[app_id=$keepassxc_id] {
		move to scratchpad
			[app_id=$keepassxc_id] scratchpad show
			$keepassxc_dimensions
	}
}

bindsym --to-code {
# Scratchpad bindsym
## Main terminal
	$mod+Shift+o  exec swaymsg [app_id=$dropdown_id]	scratchpad show || exec $dropdown
## vault
	$mod+Shift+n  exec swaymsg [app_id=$keepassxc_id]     scratchpad show || exec keepassxc
}

smart_gaps on
gaps inner 10

# workspaces
set $ws1   1:1
set $ws2   2:2
set $ws3   3:3
set $ws4   4:4
set $ws5   5:5
set $ws6   6:6
set $ws7   7:7
set $ws8   8:8
set $ws9   9:9

bindsym $mod+Return exec $term
bindsym $mod+Shift+Return exec kitty --single-instance
bindsym $mod+d exec $menu
bindsym $mod+Shift+q kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+Control+e exec $powermenu
bindsym $mod+b splith
bindsym $mod+v splitv

# window focusing
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

#window movement
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

#workspace keys
bindsym $mod+1   workspace $ws1
bindsym $mod+2   workspace $ws2
bindsym $mod+3   workspace $ws3
bindsym $mod+4   workspace $ws4
bindsym $mod+5   workspace $ws5
bindsym $mod+6   workspace $ws6
bindsym $mod+7   workspace $ws7
bindsym $mod+8   workspace $ws8
bindsym $mod+9   workspace $ws9

# move windows to workspaces
bindsym $mod+Shift+1    move container to workspace $ws1
bindsym $mod+Shift+2    move container to workspace $ws2
bindsym $mod+Shift+3    move container to workspace $ws3
bindsym $mod+Shift+4    move container to workspace $ws4
bindsym $mod+Shift+5    move container to workspace $ws5
bindsym $mod+Shift+6    move container to workspace $ws6
bindsym $mod+Shift+7    move container to workspace $ws7
bindsym $mod+Shift+8    move container to workspace $ws8
bindsym $mod+Shift+9    move container to workspace $ws9

# move windows with mouse
floating_modifier $mod normal

# swayr
bindsym $mod+Shift+s	exec swayr switch-window
bindsym $mod+Shift+d	exec swayr swap-focused-with

# lock screen
bindsym $mod+Control+q exec $lock

# move workspaces
bindsym $mod+Control+Shift+$right move workspace to output right
bindsym $mod+Control+Shift+$left move workspace to output left

# resize mode
mode "resize" {
# left will shrink the containers width
# right will grow the containers width
# up will shrink the containers height
# down will grow the containers height
		bindsym $left resize shrink width 10px
		bindsym $down resize grow height 10px
		bindsym $up resize shrink height 10px
		bindsym $right resize grow width 10px

# Return to default mode
		bindsym Return mode "default"
		bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Special keys to adjust volume via PulseAudio
bindsym --locked XF86AudioMute exec pactl set-sink-mute \@DEFAULT_SINK@ toggle
bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume \@DEFAULT_SINK@ -1%
bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume \@DEFAULT_SINK@ +1%
bindsym --locked XF86AudioMicMute exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle
# Special keys to adjust brightness via brightnessctl
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 1%-
bindsym --locked XF86MonBrightnessUp exec brightnessctl set 1%+
# Special key to take a screenshot with grim
bindsym Print exec grim

# autostart
exec $idle
exec $term_server
exec $bar
# exec $notifications
exec $wallpaper
exec $dropdown
exec $swayr
exec $brscan-skey
exec $filecloud
exec $emacs
# exec $udiskie
exec $display_config
exec $idle_inhibitor
